# Copy to .env and fill in the values you need. Never commit .env.

# --- Flask session ---------------------------------------------------------
# Random 32+ character string. Auto-generated when unset.
BIMS_SECRET_KEY=
# Path to the SQLite database. Defaults to instance/bims.sqlite3
BIMS_DATABASE=
# Set to 1 when serving over HTTPS so session cookies are marked Secure.
BIMS_COOKIE_SECURE=

# --- First admin account (setup_bims.py) ----------------------------------
BIMS_ADMIN_USERNAME=admin
BIMS_ADMIN_NAME=System Administrator
BIMS_ADMIN_PASSWORD=

# --- Moss AI assistant -----------------------------------------------------
# API key for any OpenAI-compatible provider. Leave empty to keep the
# built-in offline assistant.
MOSS_API_KEY=
# Base URL of the OpenAI-compatible endpoint.
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Ollama      http://localhost:11434/v1
MOSS_API_BASE_URL=https://api.openai.com/v1
# Model name, for example gpt-4o-mini, or a local model such as llama3.1.
MOSS_MODEL=gpt-4o-mini
# Set to 0 to force the offline assistant even when a key is present.
MOSS_ENABLED=1
# Request timeout in seconds, reply cap in tokens, and sampling temperature.
MOSS_API_TIMEOUT=30
MOSS_MAX_TOKENS=600
MOSS_TEMPERATURE=0.3
